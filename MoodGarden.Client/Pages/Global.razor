@page "/stats"
@rendermode InteractiveWebAssembly

<div class="app-container">
    <!-- Header -->
    <header class="app-header">
        <div class="logo">
            <div class="logo-badge">🌱</div>
            <span class="logo-title">Cat Mood Garden</span>
        </div>
        <nav class="nav-links">
            <NavLink href="" class="nav-item">🏡 My Garden</NavLink>
            <NavLink href="my-garden" class="nav-item">📖 My Diary</NavLink>
            <NavLink href="stats" class="nav-item active">📈 Vibe Stats</NavLink>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="content-body">
        <div class="title-row">
            <div class="title-block">
                <h2>Global Cat Vibe Check</h2>
                <p>See how other gardeners around the globe are blooming today.</p>
            </div>
            <a href="" class="back-btn">
                <span>←</span> Back to Garden
            </a>
        </div>

        <div class="chart-card">
            <h3 class="chart-title">Current Moods (Last 24 Hours)</h3>

            <div class="chart-frame">
                <!-- Y Axis -->
                <div class="y-axis">
                    <span>100%</span>
                    <span>75%</span>
                    <span>50%</span>
                    <span>25%</span>
                    <span>0%</span>
                </div>

                <!-- Plot Area -->
                <div class="plot-column">
                    <div class="plot-area">
                        <!-- Horizontal Gridlines -->
                        <div class="grid-line" style="top: 0%;"></div>
                        <div class="grid-line" style="top: 25%;"></div>
                        <div class="grid-line" style="top: 50%;"></div>
                        <div class="grid-line" style="top: 75%;"></div>
                        <div class="grid-line base" style="top: 100%;"></div>

                        <!-- Bar Columns -->
                        <div class="bars-container">
                            @foreach (var mood in globalMoods)
                            {
                                <div class="bar-column">
                                    <span class="bar-percentage">@(mood.Percentage)%</span>
                                    <div class="bar-shape" style="height: @(mood.Percentage * 2.8)px;"></div>
                                    <span class="bar-emoji">@mood.Emoji</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Legend -->
            <div class="chart-legend">
                <div class="legend-item">
                    <div class="legend-box"></div>
                    <span>Planted Moods</span>
                </div>
                <span class="legend-stats">Total active plants: 12,482 today</span>
            </div>
        </div>
    </main>
</div>

@code {
    private record MoodStat(string Emoji, int Percentage);

    private List<MoodStat> globalMoods = new()
    {
        new("😸", 32),
        new("😿", 8),
        new("😾", 12),
        new("😴", 48),
        new("🤩", 24),
        new("😳", 15),
        new("😍", 58),
        new("🙄", 18)
    };
}