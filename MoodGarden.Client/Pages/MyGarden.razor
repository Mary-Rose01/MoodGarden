@page "/my-garden"
@rendermode InteractiveWebAssembly

<div class="flex flex-col gap-8 h-full">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center w-full gap-4">
        <div class="flex flex-col gap-1.5">
            <h2 class="font-display font-extrabold text-[28px] md:text-[32px] leading-tight text-brand-dark m-0">My Cat Diary</h2>
            <p class="text-[14px] md:text-[16px] text-brand-gray m-0">A chronological memory lane of your planted feelings.</p>
        </div>
    </div>

    @if (!diaryEntries.Any())
    {
        <div class="flex flex-col items-center justify-center flex-grow p-10 bg-white border-[3px] border-brand-dark shadow-[6px_6px_0px_0px_#1E1E1E] rounded-[24px] text-center mt-4">
            <div class="text-[80px] mb-4 animate-bounce">🛌🐈</div>
            <h3 class="font-display font-bold text-[24px] text-brand-dark mb-2">It's awfully quiet here...</h3>
            <p class="text-[16px] text-brand-gray max-w-md">You haven't recorded any diary entries yet! Head back to the garden and plant a cat to start your emotional log.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
            @foreach (var entry in diaryEntries)
            {
                <div class="flex flex-col p-6 gap-4 bg-white border-[3px] border-brand-dark shadow-[4px_4px_0px_0px_#1E1E1E] rounded-[24px] transition-transform hover:-translate-y-1">
                    <div class="flex justify-between items-center w-full">
                        <div class="flex justify-center items-center w-[56px] h-[56px] bg-brand-light border-[2.5px] border-brand-dark rounded-full text-[28px]">
                            @entry.Emoji
                        </div>
                        <div class="flex items-center justify-center px-4 py-1.5 bg-brand-pink border-[2px] border-brand-dark rounded-full font-bold text-[12px] text-brand-dark shadow-[2px_2px_0px_0px_#1E1E1E]">
                            @entry.MoodName
                        </div>
                    </div>
                    <div class="flex flex-col gap-2 mt-2">
                        <span class="font-bold text-[11px] uppercase tracking-wider text-brand-gray">@entry.TimeAgo</span>
                        <p class="text-[15px] leading-relaxed text-brand-dark font-medium m-0">@entry.Note</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private record DiaryEntry(string Emoji, string MoodName, string TimeAgo, string Note);

    // Swap this to an empty list to test the rich empty state!
    private List<DiaryEntry> diaryEntries = new()
    {
        new("😴", "Sleepy", "1 hour ago", "Had a cozy afternoon nap under the imaginary big tree. Feeling refreshed and lazy."),
        new("🤩", "Starry", "3 hours ago", "Wrote a great line of code. Felt like a programming superstar wizard cat! ✨"),
        new("😍", "In Love", "Yesterday, 4:12 PM", "Had an excellent cup of hot cocoa with extra marshmallows. Absolute pure love."),
        new("😾", "Angry", "Yesterday, 10:00 AM", "Stubbed my little paw toe on the doorframe. Angrily planted a grumpy cat."),
        new("😸", "Happy", "2 days ago", "Sunshine was streaming perfectly onto my desk. Felt warm and content."),
        new("🙄", "Sassy", "3 days ago", "Received an email that could have easily been a slack message. Sassy eye-roll.")
    };
}